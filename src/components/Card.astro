---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  showDate?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  id,
  data,
  filePath,
  showDate = true,
} = Astro.props;

const { title, description, tags, pubDatetime } = data;

const dateParts = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "2-digit",
  timeZone: config.site.timezone,
}).formatToParts(new Date(pubDatetime));

const year = dateParts.find(part => part.type === "year")?.value ?? "";
const month = dateParts.find(part => part.type === "month")?.value ?? "";
---

<li class="group border-border border-t first:border-t-0">
  <div
    class:list={[
      "grid gap-2 py-7",
      { "sm:grid-cols-[5rem_1fr] sm:gap-8": showDate },
    ]}
  >
    {
      showDate && (
        <time
          datetime={new Date(pubDatetime).toISOString()}
          class="eyebrow pt-1.5 sm:pt-2"
        >
          {year} · {month}
        </time>
      )
    }

    <div class="min-w-0">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class="block focus-visible:no-underline"
      >
        <Heading
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
          class="group-hover:text-accent font-serif text-[1.15rem] leading-relaxed font-semibold tracking-tight transition-colors duration-150"
        >
          {title}
        </Heading>
      </a>

      <p class="text-muted-foreground mt-2 line-clamp-2 text-sm leading-7">
        {description}
      </p>

      {
        tags.length > 0 && (
          <p class="text-muted-foreground/80 mt-3 text-[0.68rem] tracking-[0.18em] uppercase">
            {tags.join(" · ")}
          </p>
        )
      }
    </div>
  </div>
</li>
