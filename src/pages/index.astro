---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="border-border grid gap-5 border-b py-12 sm:grid-cols-[1.1fr_1fr] sm:items-end sm:gap-12 sm:py-16"
    >
      <div>
        <p class="eyebrow">私人笔记 · {new Date().getFullYear()}</p>
        <h1 class="mt-3 text-6xl font-bold tracking-[-0.06em] sm:text-8xl">
          {config.site.title}
        </h1>
      </div>
      <p
        class="text-muted-foreground max-w-[34rem] text-base leading-8 sm:justify-self-end sm:pb-2 sm:text-lg"
      >
        {config.site.description}
      </p>
    </section>

    <div class="grid gap-12 py-12 lg:grid-cols-[2fr_1fr] lg:gap-16">
      <section id="recent-posts" class="min-w-0">
        <div
          class="border-border flex items-baseline justify-between gap-4 border-b pb-4"
        >
          <h2 class="text-xl font-bold tracking-tight">{t.home.recentPosts}</h2>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="text-muted-foreground hover:text-accent text-xs tracking-wide whitespace-nowrap transition-colors"
          >
            {t.home.allPosts} →
          </a>
        </div>
        <ul class="mt-1">
          {
            recentPosts
              .slice(0, postsConfig.perIndex + 2)
              .map(data => <Card variant="h3" {...data} />)
          }
        </ul>
      </section>

      {
        featuredPosts.length > 0 && (
          <section
            id="featured"
            class="lg:border-border min-w-0 lg:border-s lg:ps-8"
          >
            <h2 class="border-border border-b pb-4 text-xl font-bold tracking-tight">
              {t.home.featured}
            </h2>
            <ul class="mt-1">
              {featuredPosts.map(data => (
                <Card variant="h3" showDate={false} {...data} />
              ))}
            </ul>
          </section>
        )
      }
    </div>
    <div class="h-8"></div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
