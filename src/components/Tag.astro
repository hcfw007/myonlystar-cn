---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group text-muted-foreground hover:text-accent inline-flex items-baseline gap-0.5 transition-colors",
      { "text-xs tracking-[0.12em]": size === "sm" },
      { "text-base tracking-wide": size === "lg" },
    ]}
  >
    <span aria-hidden="true" class="text-accent/60 text-[0.85em]">#</span>
    <span
      class="group-hover:border-accent/50 border-b border-transparent pb-0.5"
    >
      {tagName}
    </span>
    {
      typeof count === "number" && (
        <sup class="text-muted-foreground/60 ms-0.5 text-[0.7em] tabular-nums">
          {count}
        </sup>
      )
    }
  </a>
</li>
