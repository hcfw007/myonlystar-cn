---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="pt-16 pb-14 sm:pt-24 sm:pb-20">
      <p class="eyebrow">私人笔记 · {new Date().getFullYear()}</p>
      <h1
        class="mt-5 font-serif text-5xl font-semibold tracking-tight sm:text-6xl"
      >
        记事本
      </h1>

      <p
        class="text-muted-foreground mt-7 max-w-[32rem] font-serif text-[1.02rem] leading-loose"
      >
        我是一个想法很多，但说不出来的人，希望能记录下来的一些。
        喜欢打游戏，看足球，看科普。
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-t pt-10">
          <h2 class="font-serif text-xl font-semibold tracking-tight">
            {t.home.featured}
          </h2>
          <ul class="mt-4">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-border border-t pt-10">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-serif text-xl font-semibold tracking-tight">
              {t.home.recentPosts}
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-muted-foreground hover:text-accent text-xs tracking-[0.12em] whitespace-nowrap transition-colors"
            >
              {t.home.allPosts} →
            </a>
          </div>
          <ul class="mt-4">
            {recentPosts.slice(0, postsConfig.perIndex + 2).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="h-20"></div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
