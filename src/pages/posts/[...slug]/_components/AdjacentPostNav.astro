---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="group border-border hover:border-accent/60 flex flex-col gap-2 border p-5 transition-colors"
      >
        <span class="eyebrow flex items-center gap-1.5">
          <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
          {t.post.previousPost}
        </span>
        <span class="group-hover:text-accent text-base leading-relaxed transition-colors">
          {prevPost.title}
        </span>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="group border-border hover:border-accent/60 flex flex-col items-end gap-2 border p-5 text-end transition-colors sm:col-start-2"
      >
        <span class="eyebrow flex items-center gap-1.5">
          {t.post.nextPost}
          <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
        </span>
        <span class="group-hover:text-accent text-base leading-relaxed transition-colors">
          {nextPost.title}
        </span>
      </a>
    )
  }
</div>
